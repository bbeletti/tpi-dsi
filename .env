# TODO: antes de pasar a prod, sacar este archivo del repo (git rm --cached .env),
# dejar un .env.example con valores de ejemplo y cambiar las credenciales.
COMPOSE_PROJECT_NAME=tpi-dsi
DATABASE_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
PGUSER=postgres
POSTGRES_PASSWORD=postgres
LANG=es_AR.utf8
POSTGRES_INITDB_ARGS="--locale-provider=icu --icu-locale=es-AR --auth-local=trust"
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
PORT=8000
# Google Maps JavaScript API (vacío = modo desarrollo con marca de agua)
# Restringir la key por HTTP referrer en Google Cloud Console.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
